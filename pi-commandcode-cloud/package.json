{
  "name": "@assid2/pi-commandcode-cloud",
  "version": "0.1.0",
  "description": "Command Code (commandcode.ai) model provider for Pi: OpenAI/Anthropic-compatible transport, native /login, opt-in usage footer, and a pi-usage adapter",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "provider",
    "commandcode",
    "command-code",
    "usage"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assid2/pi-extensions.git",
    "directory": "pi-commandcode-cloud"
  },
  "type": "module",
  "files": [
    "index.ts",
    "*.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "generate-models": "tsx scripts/generate-models.ts",
    "generate-metadata": "tsx scripts/generate-metadata.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "24.13.3",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
