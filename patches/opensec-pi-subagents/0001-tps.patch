#   src/ui/agent-widget.ts         per-agent + heading rate for top-level agents
#   src/workflow/rates.ts          joins workflow entries to AgentRecord through
#                                  recordId and samples each running child
#   src/ui/workflow-card.ts        aggregate on the run header, rate per task row
#   src/ui/workflow-dialog.ts      same on the inspector header and task rows
#   src/ui/workflow-menu.ts        feeds the inspector rates
#   src/index.ts                   feeds the card rates and drives a 1 s redraw
#   test/*                         sampler, widget, card, dialog, rates tests
#
# The sampler reads live `AgentRecord.lifetimeUsage.output`, not the workflow
# progress log: the log only carries totals once an agent settles.
#
# Regenerate after editing the working tree:
#   cd <source root> && git add -A && git diff --cached -- src test > 0001-tps.patch
# The updater applies this with --3way; a rejected hunk means upstream moved the
# sampled/render code, so rebase the patch (update.sh prints the commands).
#
