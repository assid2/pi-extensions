diff --git a/test/workflow-rates.test.ts b/test/workflow-rates.test.ts
new file mode 100644
index 0000000..4f88622
--- /dev/null
+++ b/test/workflow-rates.test.ts
@@ -0,0 +1,95 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import { clearTokenRates } from "../src/token-rate.js";
+import { clearWorkflowRates, workflowRates } from "../src/workflow/rates.js";
+
+function entry(over: Record<string, unknown> = {}) {
+  return {
+    type: "workflow_agent" as const,
+    index: 0,
+    label: "agent",
+    state: "progress" as const,
+    startedAt: 0,
+    recordId: "r1",
+    ...over,
+  };
+}
+
+function task(over: Record<string, unknown> = {}) {
+  return {
+    id: "wf_test",
+    status: "running",
+    workflowProgress: [entry()],
+    agentCount: 1,
+    ...over,
+  } as never;
+}
+
+function record(output: number, status = "running") {
+  return { status, lifetimeUsage: { input: 0, output, cacheWrite: 0 } } as never;
+}
+
+beforeEach(() => clearTokenRates(""));
+
+describe("workflowRates", () => {
+  it("samples per-agent and aggregate output tokens/second", () => {
+    const rec = record(100);
+    const getRecord = (id: string) => (id === "r1" ? rec : undefined);
+    const t = task();
+
+    // One sample is not a rate.
+    expect(workflowRates(t, getRecord, 1_000).runRate).toBe(0);
+
+    rec.lifetimeUsage.output = 300;
+    const rates = workflowRates(t, getRecord, 3_000);
+    expect(rates.agentRate(0)).toBeCloseTo(100);
+    expect(rates.runRate).toBeCloseTo(100);
+  });
+
+  it("sums only running children with a manager record", () => {
+    const a = record(100);
+    const b = record(500);
+    const c = record(9_000, "completed");
+    const progress = [
+      entry({ index: 0, recordId: "a" }),
+      entry({ index: 1, recordId: "b" }),
+      entry({ index: 2, recordId: "c" }),
+      entry({ index: 3, recordId: undefined }),
+    ];
+    const getRecord = (id: string) => ({ a, b, c })[id];
+    const t = task({ workflowProgress: progress, agentCount: 4 });
+
+    workflowRates(t, getRecord, 1_000);
+    a.lifetimeUsage.output = 300;
+    b.lifetimeUsage.output = 700;
+    const rates = workflowRates(t, getRecord, 3_000);
+
+    expect(rates.agentRate(0)).toBeCloseTo(100);
+    expect(rates.agentRate(1)).toBeCloseTo(100);
+    expect(rates.agentRate(2)).toBe(0);
+    expect(rates.runRate).toBeCloseTo(200);
+  });
+
+  it("reports zero for a paused or settled run", () => {
+    const rec = record(100);
+    const getRecord = () => rec;
+    expect(workflowRates(task({ status: "paused" }), getRecord, 1_000)).toEqual({
+      agentRate: expect.any(Function),
+      runRate: 0,
+    });
+    expect(workflowRates(task({ status: "completed" }), getRecord, 1_000).runRate).toBe(0);
+  });
+
+  it("clears a run's samples on settle", () => {
+    const rec = record(100);
+    const getRecord = () => rec;
+    const t = task();
+    workflowRates(t, getRecord, 1_000);
+    rec.lifetimeUsage.output = 300;
+    expect(workflowRates(t, getRecord, 3_000).runRate).toBeCloseTo(100);
+
+    clearWorkflowRates(t.id);
+    rec.lifetimeUsage.output = 900;
+    // A fresh window needs two samples again.
+    expect(workflowRates(t, getRecord, 10_000).runRate).toBe(0);
+  });
+});
