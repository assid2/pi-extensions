@@ -0,0 +1,69 @@
+/**
+ * token-rate.ts — rolling output-token/s sampler for the live agent surfaces.
+ *
+ * The agent widget renders every 80 ms, but only the *generated* (output)
+ * tokens move while a model is producing. Input and cache-read tokens jump in
+ * one step at each API-call boundary; feeding those into a rate produced
+ * implausible spikes that read as speed, so they are deliberately excluded —
+ * same rule as pi-dynamic-workflows' token-rate.ts.
+ *
+ * Samples are plain `(timestamp, cumulative output)` pairs in a 10 s rolling
+ * window. A stalled agent keeps the same total, the window ages out, and the
+ * rate decays to 0 without any explicit reset.
+ */
+
+/** Rolling window for the token/s rate. Older samples age out so a stall decays to 0. */
+const RATE_WINDOW_MS = 10_000;
+
+type SampleList = Array<{ ts: number; total: number }>;
+
+/** Push a (ts, total) sample into a rolling sample list, collapsing same-instant repeats. */
+function pushSample(samples: SampleList, now: number, total: number): void {
+  const last = samples[samples.length - 1];
+  // Collapse repeat renders within the same instant (e.g. width recalcs).
+  if (last && last.ts === now && last.total === total) return;
+  samples.push({ ts: now, total });
+  // Drop samples beyond the rolling window, always keeping >=2 so a rate is computable.
+  while (samples.length > 2 && now - samples[0].ts > RATE_WINDOW_MS) samples.shift();
+}
+
+/** Tokens/second over the oldest->newest span; 0 when there are too few samples
+ *  or the total plateaued (the stall signal). */
+function rateOver(samples: SampleList | undefined): number {
+  if (!samples || samples.length < 2) return 0;
+  const oldest = samples[0];
+  const newest = samples[samples.length - 1];
+  const elapsedMs = newest.ts - oldest.ts;
+  if (elapsedMs <= 0) return 0;
+  const delta = newest.total - oldest.total;
+  if (delta <= 0) return 0;
+  return (delta / elapsedMs) * 1000;
+}
+
+/** Sample lists keyed by surface, e.g. `agents` for the aggregate and
+ *  `agent:<id>` for one row. Cleared when the surface goes idle. */
+const tokenSamples = new Map<string, SampleList>();
+
+/** Record a cumulative output-token total for `key` at time `now` (ms). */
+export function sampleTokenRate(key: string, total: number, now: number): void {
+  const samples = tokenSamples.get(key) ?? [];
+  pushSample(samples, now, total);
+  tokenSamples.set(key, samples);
+}
+
+/** Output tokens/second over the rolling window; 0 for unknown or stalled keys. */
+export function tokenRate(key: string): number {
+  return rateOver(tokenSamples.get(key));
+}
+
+/** Forget one surface's samples. */
+export function clearTokenRate(key: string): void {
+  tokenSamples.delete(key);
+}
+
+/** Forget every surface whose key starts with `prefix` (e.g. `agent:`). */
+export function clearTokenRates(prefix: string): void {
+  for (const key of tokenSamples.keys()) {
+    if (key.startsWith(prefix)) tokenSamples.delete(key);
+  }
+}
