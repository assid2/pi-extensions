+  return { widget, render };
+}
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.setSystemTime(T0);
+  clearTokenRates("");
+});
+afterEach(() => vi.useRealTimers());
+
+describe("AgentWidget token rate", () => {
+  it("shows per-agent and aggregate output tok/s once two samples exist", () => {
+    const record: any = {
+      id: "a1",
+      type: "Explore",
+      description: "rate probe",
+      status: "running",
+      toolUses: 1,
+      startedAt: T0 - 1_000,
+      lifetimeUsage: { input: 1_000, output: 100, cacheRead: 0, cacheWrite: 0, cost: 0 },
+      compactionCount: 0,
+      isBackground: true,
+    };
+    const { widget, render } = mount(record);
+
+    // One sample is not a rate.
+    expect(render()).not.toContain("tok/s");
+
+    // 200 generated tokens over 2 s => 100 tok/s, on the row and the heading.
+    record.lifetimeUsage.output = 300;
+    vi.setSystemTime(T0 + 2_000);
+    widget.update();
+    const out = render();
+    expect(out).toContain("100 tok/s");
+    expect(out).toMatch(/Agents.*100 tok\/s/);
+
+    widget.dispose();
+  });
+
+  it("decays to 0 when output plateaus", () => {
+    const record: any = {
+      id: "a2",
+      type: "Explore",
+      description: "stall probe",
+      status: "running",
+      toolUses: 0,
+      startedAt: T0 - 1_000,
+      lifetimeUsage: { input: 1_000, output: 0, cacheRead: 0, cacheWrite: 0, cost: 0 },
+      compactionCount: 0,
+      isBackground: true,
+    };
+    const { widget, render } = mount(record);
+    expect(render()).not.toContain("tok/s");
+    record.lifetimeUsage.output = 200;
+    vi.setSystemTime(T0 + 2_000);
+    widget.update();
+    expect(render()).toContain("100 tok/s");
+
+    vi.setSystemTime(T0 + 20_000);
+    widget.update();
+    expect(render()).not.toContain("tok/s");
+
+    widget.dispose();
+  });
+});
diff --git a/test/token-rate.test.ts b/test/token-rate.test.ts
new file mode 100644
index 0000000..d0826b5
--- /dev/null
+++ b/test/token-rate.test.ts
@@ -0,0 +1,63 @@
+import { beforeEach, describe, expect, it } from "vitest";
+import { clearTokenRate, clearTokenRates, sampleTokenRate, tokenRate } from "../src/token-rate.js";
+
+describe("token rate sampler", () => {
+  beforeEach(() => clearTokenRates(""));
+
+  it("returns 0 until two samples exist", () => {
+    expect(tokenRate("a")).toBe(0);
+    sampleTokenRate("a", 100, 1_000);
+    expect(tokenRate("a")).toBe(0);
+  });
+
+  it("computes output tokens per second over the sample span", () => {
+    sampleTokenRate("a", 100, 1_000);
+    sampleTokenRate("a", 300, 3_000);
+    // 200 tokens over 2 s.
+    expect(tokenRate("a")).toBeCloseTo(100);
+  });
+
+  it("returns 0 when the total plateaus", () => {
+    sampleTokenRate("a", 100, 1_000);
+    sampleTokenRate("a", 100, 2_000);
+    sampleTokenRate("a", 100, 3_000);
+    expect(tokenRate("a")).toBe(0);
+  });
+
+  it("ages old samples out of the window", () => {
+    sampleTokenRate("a", 0, 0);
+    sampleTokenRate("a", 100, 1_000);
+    // 10 s later: the 0 s sample is outside the 10 s window and is dropped, so
+    // the rate is measured from the 1 s sample.
+    sampleTokenRate("a", 1_000, 11_000);
+    expect(tokenRate("a")).toBeCloseTo(90);
+  });
+
+  it("restarts the window when a cumulative counter resets", () => {
+    sampleTokenRate("a", 900, 1_000);
+    sampleTokenRate("a", 950, 2_000);
+    // A retry replaced the record: output starts over at 10.
+    sampleTokenRate("a", 10, 3_000);
+    expect(tokenRate("a")).toBe(0);
+    sampleTokenRate("a", 110, 4_000);
+    expect(tokenRate("a")).toBeCloseTo(100);
+  });
+
+  it("keeps keys independent and clears by prefix", () => {
+    sampleTokenRate("agent:1", 0, 0);
+    sampleTokenRate("agent:1", 100, 1_000);
+    sampleTokenRate("agent:2", 0, 0);
+    sampleTokenRate("agent:2", 200, 1_000);
+    expect(tokenRate("agent:1")).toBeCloseTo(100);
+    expect(tokenRate("agent:2")).toBeCloseTo(200);
+
+    clearTokenRates("agent:");
+    expect(tokenRate("agent:1")).toBe(0);
+    expect(tokenRate("agent:2")).toBe(0);
+
+    sampleTokenRate("agents", 0, 0);
+    sampleTokenRate("agents", 50, 1_000);
+    clearTokenRate("agents");
+    expect(tokenRate("agents")).toBe(0);
+  });
+});
