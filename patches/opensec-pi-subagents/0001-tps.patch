diff --git a/src/workflow/rates.ts b/src/workflow/rates.ts
new file mode 100644
index 0000000..6373b85
--- /dev/null
+++ b/src/workflow/rates.ts
@@ -0,0 +1,81 @@
+/**
+ * rates.ts — live output tok/s for a workflow run and its agent rows.
+ *
+ * The workflow progress log stores only completed totals (`entry.tokens`); the
+ * live figure lives on the child's `AgentRecord.lifetimeUsage.output`, which the
+ * manager updates on every `message_end`. This module joins the two: it walks the
+ * run's running entries, resolves each `recordId` through the caller's record
+ * lookup, and feeds the shared rolling sampler (`token-rate.ts`) under
+ * `workflow:<taskId>` and `workflow:<taskId>:<index>`.
+ *
+ * Same rules as the Agents widget: output tokens only (input/cache step at API
+ * boundaries and spike the rate), and a stalled agent stops being fed so its
+ * window ages out to 0.
+ */
+
+import { clearTokenRate, clearTokenRates, sampleTokenRate, tokenRate } from "../token-rate.js";
+import type { AgentRecord } from "../types.js";
+import { collapse, displayState } from "./progress.js";
+import type { WorkflowTask } from "./task.js";
+
+/** Rates the card and dialog render. `runRate` is the aggregate over running agents. */
+export interface WorkflowRates {
+  /** Generated output tokens/second for the agent entry with this stable `index`. */
+  agentRate(index: number): number;
+  /** Aggregate output tokens/second over the run's running agents. */
+  runRate: number;
+}
+
+const runKey = (taskId: string) => `workflow:${taskId}`;
+const agentPrefix = (taskId: string) => `workflow:${taskId}:`;
+const agentKey = (taskId: string, index: number) => `${agentPrefix(taskId)}${index}`;
+
+const ZERO: WorkflowRates = { agentRate: () => 0, runRate: 0 };
+
+/**
+ * Sample and return the live rates for `task`.
+ *
+ * `getRecord` is the manager's lookup (or the dialog's injected equivalent).
+ * Only a running run reports non-zero rates: a paused run accrues no output and
+ * a settled one is cleared by {@link clearWorkflowRates}.
+ */
+export function workflowRates(
+  task: WorkflowTask,
+  getRecord: (id: string) => AgentRecord | undefined,
+  now: number = Date.now(),
+): WorkflowRates {
+  if (task.status !== "running") return ZERO;
+
+  const running = collapse(task.workflowProgress).agents.filter(
+    (entry) => displayState(entry, true) === "running",
+  );
+  if (running.length === 0) {
+    clearTokenRate(runKey(task.id));
+    clearTokenRates(agentPrefix(task.id));
+    return ZERO;
+  }
+
+  let total = 0;
+  for (const entry of running) {
+    if (entry.recordId === undefined) continue;
+    const record = getRecord(entry.recordId);
+    // A finished child's output plateaus; letting it into the aggregate would
+    // freeze the total while its row still read "running" during the settle.
+    if (record === undefined || record.status !== "running") continue;
+    const output = record.lifetimeUsage.output;
+    total += output;
+    sampleTokenRate(agentKey(task.id, entry.index), output, now);
+  }
+  sampleTokenRate(runKey(task.id), total, now);
+
+  return {
+    agentRate: (index) => tokenRate(agentKey(task.id, index)),
+    runRate: tokenRate(runKey(task.id)),
+  };
+}
+
+/** Drop a run's samples when it settles so the maps cannot grow unbounded. */
+export function clearWorkflowRates(taskId: string): void {
+  clearTokenRate(runKey(taskId));
+  clearTokenRates(agentPrefix(taskId));
+}
