#!/usr/bin/env bash
# pre-commit — never commit a stale build artifact or an inconsistent release manifest.
#
# Installed by dev/setup-dev.sh via `git config core.hooksPath .githooks`.
# Bypass once with `git commit --no-verify` if you know what you are doing.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"

# --- opensec-pi-subagents is a committed build artifact -----------------------
if printf '%s\n' "$STAGED" | grep -qE '^(vendor/opensec-pi-subagents/|patches/opensec-pi-subagents/|skills/workflow-)'; then
	echo "pre-commit: opensec-pi-subagents inputs staged — rebuilding artifact…"
	"$ROOT/scripts/opensec-subagents/update.sh"
	git add -A -- opensec-pi-subagents
fi

# --- pi-atelier is a committed build artifact -------------------------------
if printf '%s\n' "$STAGED" | grep -qE '^(vendor/pi-atelier/|patches/pi-atelier/)'; then
	echo "pre-commit: pi-atelier inputs staged — rebuilding artifact…"
	"$ROOT/scripts/pi-atelier/update.sh"
	git add -A -- pi-atelier
fi

# --- the monorepo self-entry must stay unversioned -----------------------------
# apply.sh floats it to the newest release tag, so a baked-in ref is always stale.
if printf '%s\n' "$STAGED" | grep -qx 'deployment.json'; then
	node -e '
		const manifest = JSON.parse(require("node:fs").readFileSync("deployment.json", "utf8"));
		const self = (manifest.packages || []).find((p) => String(p).includes("assid2/pi-extensions"));
		if (!self) { console.error("pre-commit: ERROR: deployment.json has no monorepo self-entry"); process.exit(1); }
		if (self.slice(self.lastIndexOf("/") + 1).includes("@")) {
			console.error("pre-commit: ERROR: deployment.json self-entry must be unversioned (apply floats it to the newest release tag): " + self);
			process.exit(1);
		}
	' || exit 1
fi
